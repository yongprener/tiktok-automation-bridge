{
  "manifest_version": 3,
  "name": "TikTok Automation Bridge",
  "version": "0.3.0",
  "description": "Bridge between Hermes Agent and Chrome — remote control via Telegram for video generation, TikTok scheduling, and web scraping.",
  "author": "yongprener",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "identity",
    "identity.email",
    "alarms",
    "notifications",
    "downloads",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
